# PMPlatform API environment template: every key, names only. Every value is empty and stays empty in this file.
#
# Source of truth: workbook "Implementation work", sheet Environment and Secrets, snapshotted at
# docs/architecture/environment-and-secrets.csv (44 variables). docs/architecture/env-template-check.py fails if a
# sheet variable is missing here, a key here is not a sheet variable, or any line carries a value. The same inventory
# as JSON is src/backend/PMPlatform.Api/appsettings.Template.json; the SPA's public variables are src/frontend/.env.example.
#
# Local development: the API reads no .env file. A container takes these as `docker run --env-file <file>`; `dotnet run`
# takes the same keys from appsettings.Development.Local.json (git-ignored); docker compose sets them in
# infra/docker/docker-compose.yml. Fill only the variables whose scope includes DEV. SIT, UAT and PROD never read a file: Secret values come from the approved secret store, Public values from the
# environment's configuration (infra/environments/environments.json, TASK-016, TASK-019).
#
# Each line: NAME=   # Classification | Environment scope — purpose

DB_CONNECTION_STRING=   # Secret | DEV/SIT/UAT/PROD — PostgreSQL-compatible connection string (AlloyDB for PostgreSQL) for the primary application database
DB_BACKUP_STORAGE_CONNECTION_STRING=   # Secret | SIT/UAT/PROD — Connection string for the automated backup target
JWT_SIGNING_KEY=   # Secret | DEV/SIT/UAT/PROD — Signing key/certificate for issued session/access tokens
AD_LDAP_URL=   # Secret | SIT/UAT/PROD — Endpoint of AHDA's Active Directory/LDAP service
AD_BIND_DN=   # Secret | SIT/UAT/PROD — Service account distinguished name used to query AD/LDAP
AD_BIND_PASSWORD=   # Secret | SIT/UAT/PROD — Service account password for AD/LDAP bind
SSO_OIDC_CLIENT_ID=   # Public | DEV — OIDC/SSO client identifier registered with AHDA identity provider
SSO_OIDC_CLIENT_SECRET=   # Secret | DEV/SIT/UAT/PROD — OIDC/SSO client secret paired with the client ID
SSO_OIDC_AUTHORITY=   # Public | DEV/SIT/UAT/PROD — Base authority/issuer URL of AHDA's identity provider
SSO_OIDC_CALLBACK_URL=   # Public | DEV/SIT/UAT/PROD — Registered redirect/callback URL for the SSO flow per environment
MFA_PROVIDER_API_KEY=   # Secret | SIT/UAT/PROD — API key for the MFA verification provider
MFA_PROVIDER_ENDPOINT=   # Public | SIT/UAT/PROD — Base endpoint of the MFA verification provider
EXCHANGE_SMTP_HOST=   # Public | SIT/UAT/PROD — AHDA Exchange SMTP relay hostname for outbound email notifications
EXCHANGE_SMTP_PORT=   # Public | SIT/UAT/PROD — SMTP relay port
EXCHANGE_SMTP_USER=   # Secret | SIT/UAT/PROD — Service account username for the Exchange SMTP relay
EXCHANGE_SMTP_PASSWORD=   # Secret | SIT/UAT/PROD — Service account password/app-password for the Exchange SMTP relay
NAFATH_CLIENT_ID=   # Secret | SIT/UAT/PROD — Nafath integration client identifier (subject to PTBC-031 scope confirmation)
NAFATH_CLIENT_SECRET=   # Secret | SIT/UAT/PROD — Nafath integration client secret
NAFATH_CALLBACK_URL=   # Public | SIT/UAT/PROD — Registered callback URL for the Nafath verification flow
NAFATH_APP_ID=   # Public | SIT/UAT/PROD — Registered application identifier with the Nafath platform
DOCUMENT_STORAGE_CONNECTION_STRING=   # Secret | DEV/SIT/UAT/PROD — Connection string/credentials for private object storage backing WF-12 documents
DOCUMENT_STORAGE_BACKUP_CONNECTION_STRING=   # Secret | SIT/UAT/PROD — Connection string for the document-store backup target
MALWARE_SCAN_API_KEY=   # Secret | SIT/UAT/PROD — API key for the document malware-scanning provider
SIEM_ENDPOINT_URL=   # Public | SIT/UAT/PROD — Ingestion endpoint for AHDA's SIEM platform
SIEM_API_TOKEN=   # Secret | SIT/UAT/PROD — Authentication token for forwarding audit/security events to SIEM
SECRET_STORE_ENDPOINT=   # Public | DEV/SIT/UAT/PROD — Endpoint of the approved secret-management platform itself
SECRET_STORE_AUTH_TOKEN=   # Secret | DEV/SIT/UAT/PROD — Bootstrap credential the application uses to authenticate to the secret store
DEPLOY_SERVICE_ACCOUNT_KEY=   # Secret | SIT/UAT/PROD — Credential used by CI/CD to deploy infrastructure and application artifacts
CONTAINER_REGISTRY_TOKEN=   # Secret | All — Authentication token for pushing/pulling build artifacts
RATE_LIMIT_STORE_CONNECTION_STRING=   # Secret | SIT/UAT/PROD — Connection string for the distributed rate-limit counter store (e.g. Redis)
CORS_ALLOWED_ORIGINS=   # Public | DEV/SIT/UAT/PROD — Comma-separated allowlist of frontend origins permitted to call the API
APP_BASE_URL=   # Public | DEV/SIT/UAT/PROD — Canonical public base URL of the application per environment
PASSWORD_RESET_URL=   # Public | DEV/SIT/UAT/PROD — URL of AHDA's password reset page that the sign-in page links to
LOG_LEVEL=   # Public | DEV/SIT/UAT/PROD — Application log verbosity level
APM_DSN=   # Secret | SIT/UAT/PROD — Ingestion key/DSN for the APM/error-tracking provider
APM_ENVIRONMENT_TAG=   # Public | DEV/SIT/UAT/PROD — Environment tag attached to APM events (dev/sit/uat/prod)
UPTIME_MONITOR_API_KEY=   # Secret | SIT/UAT/PROD — API key for the external uptime-monitoring service
ALERT_CHANNEL_WEBHOOK_URL=   # Secret | SIT/UAT/PROD — Webhook URL for routing operational alerts to the on-call channel
E2E_TEST_USER_CREDENTIALS_SECRET_REF=   # Secret | DEV/SIT — Reference to the secret-store entry holding synthetic end-to-end test user credentials (never real AHDA use...
LEGACY_SYSTEM_CONNECTION_STRING=   # Secret | Cutover window only — Read-only, time-boxed connection to AHDA's legacy project-records source for cutover (source system TBC, se...
SMS_PROVIDER_API_KEY=   # Secret | SIT/UAT/PROD — API key or token for the SMS provider gateway
SMS_PROVIDER_ENDPOINT=   # Public | SIT/UAT/PROD — Base endpoint of the SMS provider API
SMS_SENDER_ID=   # Public | SIT/UAT/PROD — Registered alphanumeric sender ID shown to recipients
SMS_DLR_CALLBACK_URL=   # Public | SIT/UAT/PROD — Registered callback URL receiving delivery receipts from the provider

# ---------------------------------------------------------------------------------------------------------------------
# FG-05 alert thresholds (TASK-092; register docs/operations/alert-thresholds.json, AT-1 to AT-6). Not sheet variables:
# settings the API reads as IntegrationMonitoring:Policy, one per registered integration code. Every value is AHDA's and
# open (PTBC-037), so every line is commented out and an absent setting means "no threshold". Uncomment a line only
# with a value: an empty duration is ignored, but an empty QueueBacklogThresholds bound declares a backlog threshold with
# no bound, and the API refuses to start. In SIT, UAT and PROD they are set in infra/terraform/environments/<env>/terraform.tfvars
# (integration_alert_thresholds), not here. Units: durations hh:mm:ss, depth and tolerance whole numbers, rate 0 to 1.
# An integration registered later takes the same keys with its own code.

# DIRECTORY
# IntegrationMonitoring__Policy__AvailabilityAlertDelays__DIRECTORY=   # AT-1 duration DOWN before the AVAILABILITY alert; absent: at once
# IntegrationMonitoring__Policy__FreshnessWindows__DIRECTORY=   # AT-2 FRESH for this long after the last success; absent: freshness UNKNOWN
# IntegrationMonitoring__Policy__QueueBacklogThresholds__DIRECTORY__Depth=   # AT-3 QUEUE_BACKLOG when more operations are queued than this
# IntegrationMonitoring__Policy__QueueBacklogThresholds__DIRECTORY__OldestAge=   # AT-4 QUEUE_BACKLOG when the oldest has waited longer than this
# IntegrationMonitoring__Policy__ReconciliationMismatchTolerances__DIRECTORY=   # AT-5 mismatches tolerated without an alert; absent: none
# IntegrationMonitoring__Policy__MinimumDeliveryRates__DIRECTORY=   # AT-6 DELIVERY_RATE below this rate; absent: no alert

# SSO
# IntegrationMonitoring__Policy__AvailabilityAlertDelays__SSO=   # AT-1 duration DOWN before the AVAILABILITY alert; absent: at once
# IntegrationMonitoring__Policy__FreshnessWindows__SSO=   # AT-2 FRESH for this long after the last success; absent: freshness UNKNOWN
# IntegrationMonitoring__Policy__QueueBacklogThresholds__SSO__Depth=   # AT-3 QUEUE_BACKLOG when more operations are queued than this
# IntegrationMonitoring__Policy__QueueBacklogThresholds__SSO__OldestAge=   # AT-4 QUEUE_BACKLOG when the oldest has waited longer than this
# IntegrationMonitoring__Policy__ReconciliationMismatchTolerances__SSO=   # AT-5 mismatches tolerated without an alert; absent: none
# IntegrationMonitoring__Policy__MinimumDeliveryRates__SSO=   # AT-6 DELIVERY_RATE below this rate; absent: no alert

# MFA
# IntegrationMonitoring__Policy__AvailabilityAlertDelays__MFA=   # AT-1 duration DOWN before the AVAILABILITY alert; absent: at once
# IntegrationMonitoring__Policy__FreshnessWindows__MFA=   # AT-2 FRESH for this long after the last success; absent: freshness UNKNOWN
# IntegrationMonitoring__Policy__QueueBacklogThresholds__MFA__Depth=   # AT-3 QUEUE_BACKLOG when more operations are queued than this
# IntegrationMonitoring__Policy__QueueBacklogThresholds__MFA__OldestAge=   # AT-4 QUEUE_BACKLOG when the oldest has waited longer than this
# IntegrationMonitoring__Policy__ReconciliationMismatchTolerances__MFA=   # AT-5 mismatches tolerated without an alert; absent: none
# IntegrationMonitoring__Policy__MinimumDeliveryRates__MFA=   # AT-6 DELIVERY_RATE below this rate; absent: no alert

# NAFATH
# IntegrationMonitoring__Policy__AvailabilityAlertDelays__NAFATH=   # AT-1 duration DOWN before the AVAILABILITY alert; absent: at once
# IntegrationMonitoring__Policy__FreshnessWindows__NAFATH=   # AT-2 FRESH for this long after the last success; absent: freshness UNKNOWN
# IntegrationMonitoring__Policy__QueueBacklogThresholds__NAFATH__Depth=   # AT-3 QUEUE_BACKLOG when more operations are queued than this
# IntegrationMonitoring__Policy__QueueBacklogThresholds__NAFATH__OldestAge=   # AT-4 QUEUE_BACKLOG when the oldest has waited longer than this
# IntegrationMonitoring__Policy__ReconciliationMismatchTolerances__NAFATH=   # AT-5 mismatches tolerated without an alert; absent: none
# IntegrationMonitoring__Policy__MinimumDeliveryRates__NAFATH=   # AT-6 DELIVERY_RATE below this rate; absent: no alert

# EXCHANGE_EMAIL
# IntegrationMonitoring__Policy__AvailabilityAlertDelays__EXCHANGE_EMAIL=   # AT-1 duration DOWN before the AVAILABILITY alert; absent: at once
# IntegrationMonitoring__Policy__FreshnessWindows__EXCHANGE_EMAIL=   # AT-2 FRESH for this long after the last success; absent: freshness UNKNOWN
# IntegrationMonitoring__Policy__QueueBacklogThresholds__EXCHANGE_EMAIL__Depth=   # AT-3 QUEUE_BACKLOG when more operations are queued than this
# IntegrationMonitoring__Policy__QueueBacklogThresholds__EXCHANGE_EMAIL__OldestAge=   # AT-4 QUEUE_BACKLOG when the oldest has waited longer than this
# IntegrationMonitoring__Policy__ReconciliationMismatchTolerances__EXCHANGE_EMAIL=   # AT-5 mismatches tolerated without an alert; absent: none
# IntegrationMonitoring__Policy__MinimumDeliveryRates__EXCHANGE_EMAIL=   # AT-6 DELIVERY_RATE below this rate; absent: no alert

# SMS
# IntegrationMonitoring__Policy__AvailabilityAlertDelays__SMS=   # AT-1 duration DOWN before the AVAILABILITY alert; absent: at once
# IntegrationMonitoring__Policy__FreshnessWindows__SMS=   # AT-2 FRESH for this long after the last success; absent: freshness UNKNOWN
# IntegrationMonitoring__Policy__QueueBacklogThresholds__SMS__Depth=   # AT-3 QUEUE_BACKLOG when more operations are queued than this
# IntegrationMonitoring__Policy__QueueBacklogThresholds__SMS__OldestAge=   # AT-4 QUEUE_BACKLOG when the oldest has waited longer than this
# IntegrationMonitoring__Policy__ReconciliationMismatchTolerances__SMS=   # AT-5 mismatches tolerated without an alert; absent: none
# IntegrationMonitoring__Policy__MinimumDeliveryRates__SMS=   # AT-6 DELIVERY_RATE below this rate; absent: no alert
