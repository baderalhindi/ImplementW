<Project>
  <!-- Backend build baseline (TASK-011, ADR-002 §4.1: .NET 10 LTS, Roslyn analyzers, warnings-as-errors). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Required for IDE0005 (unnecessary using) to be reported at build time. CS1591 (missing XML comment) is not enforced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('PMPlatform.Tests.'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- TASK-084: in CI every `dotnet test` collects business-logic coverage, so no test step can be left out of the coverage
       gate (docs/testing/test-strategy.md §5). Locally, pass `-s src/backend/coverage.runsettings` to do the same. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('PMPlatform.Tests.')) And '$(CI)' == 'true'">
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverage.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
