# The e2e suite's people (TASK-085), added to the test directory (infra/docker/ldap/directory.ldif) in the e2e stack's
# directory image only. Synthetic people on the reserved pmplatform.local domain; the integration tests never see them.
#
# entryUUID is each person's directory subject: e2e/stack/provision/10-people.sql stores the same value in
# identity_access.user.directory_subject_id (synthetic kind e2e3). DEPT-E2E and DEPT-E2E-OTHER are the e2e departments'
# directory_reference values.
#
# Every userPassword below is a LOCAL DEFAULT, never a real credential ("e2e-directory-password"). On SIT the same
# personas are SIT directory accounts whose credentials come from E2E_TEST_USER_CREDENTIALS_SECRET_REF.

dn: uid=e2e.admin,ou=People,dc=pmplatform,dc=local
objectClass: inetOrgPerson
uid: e2e.admin
cn: E2E Administrator
sn: Administrator
displayName: E2E Administrator
mail: e2e.admin@pmplatform.local
title: System Administrator
departmentNumber: DEPT-E2E
entryUUID: 00000000-e2e3-4000-8000-000000000001
userPassword: e2e-directory-password

