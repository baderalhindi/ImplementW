# PMPlatform frontend environment template (TASK-013). Names only: every value is empty and stays empty here.
#
# Source of truth: workbook "Implementation work", sheet Environment and Secrets, snapshotted at
# docs/architecture/environment-and-secrets.csv. VITE_<NAME> is sheet row <NAME>; the prefix is what lets
# vite.config.ts (envPrefix: 'VITE_') put the value in the bundle. docs/architecture/env-template-check.py
# fails if a variable here is not a sheet row, is not classified Public, or has a value.
#
# Everything in a Vite bundle is public once built (ADR-003 T-1), so no variable the sheet classifies Secret
# is ever listed here, and no DB_* variable can be. The complete inventory of all 43 sheet variables is
# src/backend/PMPlatform.Api/appsettings.Template.json.
#
# Local development: copy to .env.local (git-ignored) and fill in. SIT/UAT/PROD values are supplied by the
# build pipeline per environment (TASK-016, TASK-018) — VITE_ values are fixed at build time, not at deploy.

# Application
VITE_APP_BASE_URL=            # Public | DEV/SIT/UAT/PROD — canonical public base URL of the application, per environment

# Single sign-on, OIDC (TASK-028 decides whether the SPA or the API initiates the redirect; if the API does, these three are unused by the frontend and are removed from this file then)
VITE_SSO_OIDC_AUTHORITY=      # Public | DEV/SIT/UAT/PROD — base authority/issuer URL of AHDA's identity provider
VITE_SSO_OIDC_CLIENT_ID=      # Public | DEV (test tenant)/SIT/UAT/PROD — OIDC client identifier; a client ID is not a secret by itself
VITE_SSO_OIDC_CALLBACK_URL=   # Public | DEV/SIT/UAT/PROD — registered redirect/callback URL for the SSO flow, per environment

# Observability (TASK-090). APM_DSN is classified Secret and is therefore server-side only
VITE_APM_ENVIRONMENT_TAG=     # Public | DEV/SIT/UAT/PROD — environment tag attached to APM events (dev/sit/uat/prod)
