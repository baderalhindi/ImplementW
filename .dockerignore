# Build context for infra/docker/*.Dockerfile is the repository root (TASK-014). Send only what the images need.
*
!global.json
# The analyzer and code-style configuration, so the image compiles under the same rules as CI (TASK-024).
!.editorconfig
!src/backend/
!src/frontend/
src/backend/**/bin/
src/backend/**/obj/
src/backend/**/appsettings.*.Local.json
src/frontend/node_modules/
src/frontend/dist/
src/frontend/.env
src/frontend/.env.*
