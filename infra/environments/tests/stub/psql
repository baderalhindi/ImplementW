#!/usr/bin/env sh
# Stand-in psql for verify-separation-test.sh. STUB_PSQL=rejected (default) | unreachable | connected.
case "${STUB_PSQL:-rejected}" in
  connected) echo 1 ;;
  unreachable) echo 'psql: error: connection to server at "sit-db" (10.0.0.5), port 5432 failed: timeout expired' >&2; exit 2 ;;
  *) echo 'psql: error: connection to server at "sit-db" (10.0.0.5), port 5432 failed: FATAL:  password authentication failed for user "pmplatform_dev"' >&2; exit 2 ;;
esac
