# In the directory, not in the platform: signs in to the directory but has no platform user.
dn: uid=local.unregistered,ou=People,dc=pmplatform,dc=local
objectClass: inetOrgPerson
uid: local.unregistered
cn: Local Unregistered
sn: Unregistered
mail: local.unregistered@pmplatform.local
